# Spec Detective — Backend environment
# Copy to .env and fill in at least one LLM provider key.
# Never commit .env — it is gitignored.

# --- LLM provider (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Model id for the chosen provider. Must match the key you set above.
# Anthropic: claude-sonnet-4-6, claude-sonnet-4-5
# OpenAI:    gpt-4o, gpt-4o-mini
# Gemini:    gemini-2.5-flash, gemini-2.5-flash-lite
MODEL_NAME=gemini-2.5-flash

# Include token/cost metrics in /runs responses
LOG_COST=true

# Copy to .env and fill in at least one provider key.
# micro1 does not provide API credits.

# Preferred if present:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Used on this machine for the baseline (Gemini):
GEMINI_API_KEY=

# Model id for the chosen provider.
# Examples: claude-sonnet-4-6, gpt-4o, gemini-2.5-flash
MODEL_NAME=gemini-2.5-flash

LOG_COST=true
